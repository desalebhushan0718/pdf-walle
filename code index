.row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.go{margin-top:18px;width:100%;border:0;border-radius:11px;background:var(--accent);color:var(--accent-ink);font:800 1.02rem inherit;font-family:inherit;padding:14px;cursor:pointer}
