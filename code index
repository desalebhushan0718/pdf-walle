.foot{display:flex;gap:18px;flex-wrap:wrap;max-width:680px;margin:56px auto 0;padding-top:18px;border-top:1px solid var(--line);color:var(--mute);font-size:.9rem}
.foot span{margin-right:auto}
.done{position:relative}
.done span{flex:1;min-width:0}
.tick{width:30px;height:30px;flex:none;fill:none;stroke:var(--accent);stroke-width:3;stroke-linecap:round;stroke-linejoin:round}
.burst{position:absolute;left:29px;top:50%;pointer-events:none}
.burst i{position:absolute;width:8px;height:8px;margin:-4px 0 0 -4px;border-radius:50%;background:var(--accent);opacity:0}
.burst i:nth-child(even){background:var(--ink);width:5px;height:5px}
@media (prefers-reduced-motion:no-preference){
.done{animation:pop .5s cubic-bezier(.2,1.3,.4,1)}
.tick path{stroke-dasharray:24;stroke-dashoffset:24;animation:draw .45s .25s ease forwards}
.burst i{animation:fly .85s .3s ease-out forwards}
@keyframes pop{from{transform:scale(.92) translateY(12px);opacity:0}}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes fly{0%{opacity:1;transform:rotate(var(--a)) translateX(0)}100%{opacity:0;transform:rotate(var(--a)) translateX(54px) scale(.3)}}
