.cta{display:inline-block;background:var(--accent);color:var(--accent-ink);font-weight:800;padding:14px 22px;border-radius:11px;text-decoration:none}
.stack{position:relative;height:270px}
.stack i{position:absolute;inset:0 20%;background:var(--panel);border:1px solid var(--line);border-radius:8px}
.stack i:nth-child(1){transform:rotate(-9deg) translateX(-12%)}
.stack i:nth-child(2){transform:rotate(6deg) translateX(10%)}
.stack i:nth-child(3){background:repeating-linear-gradient(transparent 0 22px,var(--line) 22px 24px),var(--panel);border-color:var(--accent);transform:rotate(-2deg)}
.stack span{position:absolute;inset:0;display:grid;place-items:center;transform:rotate(-35deg);font-weight:800;font-size:1.3rem;color:var(--accent);opacity:.4}
.sec{padding-top:48px;max-width:680px;margin:0 auto}
