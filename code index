.done button,.done a{border:0;background:var(--accent);color:var(--accent-ink);font:700 .95rem inherit;font-family:inherit;padding:10px 16px;border-radius:9px;cursor:pointer;text-decoration:none}
.note{margin-top:22px;color:var(--mute);font-size:.88rem}
@media (prefers-reduced-motion:no-preference){.drop{transition:border-color .15s}}
.tool{max-width:680px;margin:0 auto;scroll-margin-top:16px}
